<?xml version="1.0" encoding="utf-8"?>
<!-- Dev (debug) builds only: the text-to-speech engine. Release builds are made
     without this file, so they don't contain the engine or its entries. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app find TTS engines (its own included) when testing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>

        <!-- The system text-to-speech engine. Chosen in Settings as the
             preferred engine; apps reach it through android.speech.tts. -->
        <service
            android:name=".tts.DistilleryTtsService"
            android:exported="true"
            android:label="@string/tts_service_label">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <!-- Voice data checks Settings and apps make against the engine. -->
        <activity
            android:name=".tts.VoiceDataActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
